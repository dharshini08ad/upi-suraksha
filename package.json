{
  "name": "upi-suraksha",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "UPI Suraksha - National UPI Payment Verification Service (frontend demo)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "scorecheck": "tsx scripts/score-samples.ts",
    "smoke": "esbuild scripts/render-smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.cache/render-smoke.cjs --log-level=error && node node_modules/.cache/render-smoke.cjs",
    "check": "npm run typecheck && npm run scorecheck && npm run smoke"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
